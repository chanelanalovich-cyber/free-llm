# Скопируйте этот файл в .env.local и заполните значения.
# .env.local в git не попадает, ключ не должен появляться в клиентском коде.

# --- Пресет 1: OpenRouter, бесплатные модели (по умолчанию) ---
# Ключ: https://openrouter.ai/keys (sk-or-v1-...), карта не нужна.
# openrouter/free — роутер, который сам выбирает доступную бесплатную модель.
# Бесплатный лимит: 20 запросов/мин, 50 запросов/сутки.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-v1-вставьте-свой-ключ
LLM_MODEL=openrouter/free

# --- Пресет 2: DeepSeek напрямую (очень дёшево, нужен депозит) ---
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=deepseek-chat

# --- Пресет 3: локальный OmniRoute (OpenAI-совместимый прокси) ---
# LLM_BASE_URL=http://localhost:20130/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gemini/gemini-2.0-flash

# --- Пресет 4: Qwen / DashScope compatible-mode ---
# LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=qwen-plus
